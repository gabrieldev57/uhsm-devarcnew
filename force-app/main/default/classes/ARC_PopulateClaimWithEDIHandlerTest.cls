        policy.ARC_Contract__c = contract[0].Id;
        policy.NameInsuredId = acc.Id;
        insert policy;

        InsurancePolicyParticipant ipp = new InsurancePolicyParticipant();
        ipp.Role = 'Primary';
        ipp.PrimaryParticipantContactId = accountListContactIds[0].PersonContactId;
        ipp.InsurancePolicyId = policy.Id;
        insert ipp;
    }

